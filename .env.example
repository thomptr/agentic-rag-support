# Langfuse (observability)
# Local dev: paste the raw keys here. They're auto-loaded by src/observability/
# langfuse_init.py via python-dotenv and the Streamlit sidebar will show a
# green "connected" badge once both keys + a reachable host are set.
# Cloud dev: leave these blank — AgentCore Runtime sets LANGFUSE_SECRET_REF /
# LANGFUSE_PUBLIC_REF env vars pointing at Secrets Manager ARNs instead.
# LANGFUSE_BASE_URL is accepted as an alias for LANGFUSE_HOST.
# Set LANGFUSE_REQUIRED=true in CI to make init failure a hard error.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
# LANGFUSE_REQUIRED=false

OPENAI_API_KEY=sk-...
DATABASE_URL=postgresql+psycopg://agentic_rag:agentic_rag_dev@localhost:5432/agentic_rag
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
LOG_LEVEL=INFO


TOOL_RATE_LIMIT_PER_MINUTE=10 
TOOL_DOLLAR_CAP=100.0 
APPROVAL_TIMEOUT_SECONDS=300 
TOOL_EXECUTION_ENABLED=true 

GATEWAY_URL=
COGNITO_TOKEN_URL=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_SCOPE=